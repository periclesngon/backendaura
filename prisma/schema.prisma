model MarketplaceRequest {
  id            String                   @id @default(cuid())
  studentId     String
  tutorId       String
  requestType   MarketplaceRequestType
  subject       String
  description   String
  urgency       UrgencyLevel             @default(MEDIUM)
  status        MarketplaceRequestStatus @default(PENDING)
  requestedDate DateTime?
  completedDate DateTime?
  feedbackId    String? // Link to AIFeedback if requestType is EXPERTISE
  response      String? // Tutor's response/notes
  metadata      Json? // Additional data (e.g., session details, message thread)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  student User @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)
  tutor   User @relation("TutorRequests", fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, status])
  @@index([studentId, status])
  @@index([status, createdAt])
  @@index([requestType, status])
  @@map("marketplace_requests")
}

