{
  "name": "tcf-tef-backend-tests",
  "version": "1.0.0",
  "description": "Test components for TCF/TEF Backend API",
  "scripts": {
    "test": "jest",
    "test:unit": "jest unit-tests/",
    "test:integration": "jest integration-tests/",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "supertest": "^6.3.3",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "collectCoverageFrom": [
      "../src/**/*.{js,ts}",
      "!../src/**/*.test.{js,ts}",
      "!../node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testTimeout": 30000,
    "verbose": true
  }
}
